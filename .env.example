# Scrumban-Backend-V2 — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite .env.

# ─── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

# ─── Database (Postgres) ──────────────────────────────────────────────
POSTGRES_USER=scrumban
POSTGRES_PASSWORD=scrumban_dev_2026
POSTGRES_DB=scrumban_v2
POSTGRES_PORT=5433
DATABASE_URL=postgresql://scrumban:scrumban_dev_2026@localhost:5433/scrumban_v2?schema=public

# ─── Redis (Cache + BullMQ) ───────────────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ─── Auth (JWT) ───────────────────────────────────────────────────────
# ATENÇÃO: só existem aqui variáveis que o código REALMENTE lê.
# Removidas em F1 (item 1.7) por serem CONFIG MORTA — declaradas mas
# ignoradas por todo o código: JWT_ACCESS_EXPIRATION, JWT_REFRESH_EXPIRATION,
# JWT_ALGORITHM. Config morta em auth é armadilha: alguém "ajusta o TTL",
# nada acontece, e a confiança no arquivo morre junto.
JWT_SECRET=change-me-in-production-use-256-bit-secret

# Validade do ACCESS token, em SEGUNDOS (lida em auth.module + auth.service).
# 900 = 15 min. Default do código quando ausente: 900.
JWT_EXPIRES_IN=900

# Validade do REFRESH token, em DIAS (RefreshTokenService). Default: 7.
REFRESH_TOKEN_EXPIRY_DAYS=7

# Janela de tolerância (grace) do refresh token IMEDIATAMENTE anterior, em
# SEGUNDOS (F1, item 1.1). Um refresh que chegue com o token anterior DENTRO
# desta janela é corrida entre abas — rotaciona e NÃO revoga. Fora dela, é
# replay real → revoga a sessão + evento de segurança (RFC 9700).
# Também é o horizonte do cache de idempotência do POST /auth/refresh.
# Default: 60. NÃO aumentar sem necessidade — é a janela em que um token
# roubado ainda seria aceito.
AUTH_REFRESH_GRACE_SECONDS=60

# Algoritmo: HS256, fixo pelo @nestjs/jwt (não é configurável por env — a
# variável JWT_ALGORITHM que existia aqui nunca foi lida por ninguém).

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── Timezone ─────────────────────────────────────────────────────────
TZ=America/Sao_Paulo

# ─── Feature Flags (opt-in modules) ───────────────────────────────────
TELEGRAM_ENABLED=false
MCP_ENABLED=false
WEBHOOKS_ENABLED=true
AUTOMATION_ENABLED=false
EMAIL_ENABLED=false

# ─── Telegram (F10) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Groq Whisper (voz — F10) ─────────────────────────────────────────
GROQ_API_KEY=

# ─── MCP Server (F11) ─────────────────────────────────────────────────
MCP_RATE_LIMIT_PER_MINUTE=60

# ─── Webhooks outbound (F12) ──────────────────────────────────────────
WEBHOOK_RETRY_MAX=3
WEBHOOK_FAILURE_THRESHOLD=10

# ─── Automation Claude Code (F13) ─────────────────────────────────────
AGENT_INSTALL_TOKEN_TTL_MIN=30
AUTOMATION_HEARTBEAT_INTERVAL_SEC=30
AUTOMATION_HEARTBEAT_OFFLINE_AFTER_SEC=90
STRICT_RISK_GATE=true
GITHUB_API_TOKEN=

# ─── Email (F4) ───────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@scrumban.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Para SendGrid/Resend usar:
# EMAIL_PROVIDER=resend  (ou sendgrid)
# EMAIL_API_KEY=...

# ─── Invites por email (ADR-V2-028) ───────────────────────────────────
# URL absoluta usada para montar o link /invite?token=... no email.
# Em producao: https://app.scrumban.com.br (Dokploy frontend).
APP_BASE_URL=http://localhost:3001

# ─── IA / Nexus multi-provider (ADR-V2-064) ───────────────────────────
# Chaves de fallback (dev). Em produção, cadastrar via POST /ai/keys.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Nível "user" da cascata (BYOK pessoal). Desligado nesta fase.
ENABLE_USER_LEVEL_KEYS=false
# Chave-mestra da criptografia at-rest das chaves de IA (R-2 / ADR-V2-064).
# Hex de 64 chars (32 bytes). Gere com: openssl rand -hex 32
# Sem ela, gravar/ler chave cifrada falha com erro claro (dev: fallback sha256 + warn).
AI_KEYS_ENCRYPTION_KEY=

# ─── Database Logging (debug N+1) ─────────────────────────────────────
DATABASE_LOGGING=false
