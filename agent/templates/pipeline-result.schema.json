{
  "$comment": "ESPELHO de agent/src/claude-code/pipeline-contract.ts (ADR-V2-083). Gerado; teste anti-drift garante igualdade. Copiar para Devari-Core junto com scrumban-executar.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "decision",
    "reviewScore",
    "stages",
    "branch",
    "commit",
    "prUrl",
    "summary"
  ],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "NEEDS_CHANGES",
        "REJECTED",
        "NO_CHANGES",
        "ABORTED"
      ]
    },
    "reviewScore": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10
    },
    "reviewFile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "stages": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "skipped",
              "failed"
            ]
          }
        }
      }
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "prUrl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
